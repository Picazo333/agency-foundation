# Copy to .env locally. Never commit real secrets.
# IMPORTANT: This file must NOT contain real credentials.
# If you add new required environment variables, add them here with empty or clearly synthetic placeholder values.

# Example placeholders only (intentionally not shaped like real credentials):
# API_BASE_URL=https://api.example.com
# ANALYTICS_ID=REPLACE_WITH_ANALYTICS_ID
# CMS_URL=https://cms.example.com
# OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
